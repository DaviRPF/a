# Google Gemini API Key
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_chave_api_aqui

# 2Captcha Token (para resolver captchas do Google automaticamente)
# 1. Crie uma conta em: https://2captcha.com
# 2. Adicione crédito (cerca de $3 = 1000 captchas)
# 3. Copie sua API key em: https://2captcha.com/enterpage
# Deixe em branco para desabilitar resolução automática de captcha
TWOCAPTCHA_TOKEN=sua_chave_2captcha_aqui
